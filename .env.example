# Gmail SMTP. Generate an App Password in the Google Account settings;
# never commit the real password to the repository.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="Your Website <your-sender@gmail.com>"

# Temporary recipient requested for testing.
LEAD_RECIPIENT=test@gmail.com
PORT=3001
EMAIL_TRANSPORT=smtp

# Optional but recommended bot protection for the public lead form.
# The VITE key is public; the secret key must only exist in Netlify/server environment variables.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
